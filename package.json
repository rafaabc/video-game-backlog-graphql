{
  "name": "video-game-backlog-graphql",
  "version": "1.0.0",
  "description": "Video Game Backlog GraphQL API (in-memory, JWT) built for API testing practice",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start:graphql": "node src/server.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "mocha",
    "test:report": "mocha --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=report,overwrite=true",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "supertest": "^7.3.1"
  }
}
